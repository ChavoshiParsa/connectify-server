generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AvatarColor {
  RED
  ORANGE
  AMBER
  YELLOW
  LIME
  GREEN
  EMERALD
  TEAL
  CYAN
  SKY
  BLUE
  INDIGO
  VIOLET
  PURPLE
  FUCHSIA
  PINK
  ROSE
}

enum UserStatus {
  ONLINE
  OFFLINE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoomType {
  DM
  GROUP
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  publicId String @unique @default(nanoid())
  email    String @unique
  username String @unique
  // emailLower    String    @unique @map("email_lower")
  // usernameLower String    @unique @map("username_lower")

  firstName   String
  lastName    String?
  biography   String?
  avatarUrl   String?
  avatarColor AvatarColor @default(SKY)

  lastLoginAt  DateTime?
  lastActiveAt DateTime?
  status       UserStatus @default(ONLINE)

  passwordHash String
  roles        String[]     @default([])
  sessions     Session[]
  messages     Message[]
  roomMembers  RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      RoomType @default(DM)
  name      String?
  avatarUrl String?

  dmKey         String?
  lastMessageId String?  @unique @db.ObjectId
  lastMessage   Message? @relation("RoomLastMessage", fields: [lastMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  RoomMember[]
  messages Message[]

  @@unique([type, dmKey])
  @@index([type])
}

model RoomMember {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  roomId String @db.ObjectId
  userId String @db.ObjectId

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  role        GroupRole? @default(MEMBER)
  joinedAt    DateTime   @default(now())
  unreadCount Int        @default(0)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Session {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  hashedRt  String
  deviceId  String
  userAgent String
  ip        String

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, createdAt])
  @@index([userId, hashedRt])
}

model Message {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  roomId   String @db.ObjectId
  room     Room   @relation(fields: [roomId], references: [id])
  senderId String @db.ObjectId
  sender   User   @relation(fields: [senderId], references: [id])

  content     String
  attachments Json?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  receipts      MessageReceipt[]
  lastMessageIn Room?            @relation("RoomLastMessage")

  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
}

model MessageReceipt {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  messageId   String    @db.ObjectId
  userId      String    @db.ObjectId
  deliveredAt DateTime  @default(now())
  readAt      DateTime?
  message     Message   @relation(fields: [messageId], references: [id])

  @@unique([messageId, userId])
  @@index([userId])
}
